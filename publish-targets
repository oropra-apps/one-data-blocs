# ============================================================================
#  One Data — cibles de publication par module
#
#  Un module listé ici est en DÉPLOIEMENT CIBLÉ : publish.sh ne le promeut
#  jamais en version par défaut de la flotte, et l'épingle automatiquement
#  sur le ou les tenants indiqués.
#
#  Format :  <module> = <slug tenant>[,<slug tenant>…]
#  Un module absent de ce fichier garde le comportement historique
#  (promotion en défaut de flotte).
#
#  Pour sortir un module du mode ciblé : retirer sa ligne, ou publier une
#  fois avec --force-default.
# ============================================================================

# Modules refondus pour Team Colin : ils appellent des fonctions SQL
# (dashboard_tc_*, perf_equipe_tc, …) qui n'existent que dans ce tenant.
# Les promouvoir en défaut casserait les autres clients.
dashboard     = teamcolin
performances  = teamcolin
site-bus      = teamcolin
topnav        = teamcolin
phone3cx      = teamcolin
# Objectifs : la version du dépôt est celle de Team Colin (v8, KPI du
# reporting maison). Le reste de la flotte est en v3. Ajouté le 04/10/2026 :
# sans cette ligne, publier objectifs remplaçait la v3 de tous les clients.
objectifs     = teamcolin

# Notifications refondues (dette client) : elles appellent notif_lire,
# notif_feu, notif_dettes, notif_reporter… qui n'existent que chez Team Colin.
# Sans cette ligne, publish.sh les promouvrait en defaut de flotte et la page
# Notifications des autres clients tomberait en erreur.
notifications = teamcolin
notif-badge   = teamcolin

# Lead management : la version du dépôt est celle de Team Colin depuis la v49
# (poste du plateau VROOM, fonctions plateau_* propres à ce tenant). Le reste
# de la flotte reste sur la v48 (tag lead-mgmt-v48). Ajouté le 05/10/2026.
lead-mgmt     = teamcolin

# Centre d'aide et visites guidées : depuis la v4 (06/10/2026), ils décrivent
# les écrans de Team Colin (postes du lead management, tableau de bord,
# performances et objectifs du reporting maison). Le reste de la flotte
# reste sur tutos v3 / tours v3.
tutos         = teamcolin
tours         = teamcolin

# Fenêtre WhatsApp : depuis la v7 (09/10/2026), elle envoie un QUATRIÈME
# paramètre de modèle — le motif écrit par le vendeur — et affiche l'aperçu du
# message rendu. Ce quatrième paramètre n'existe que dans le `wa-send-text` et
# les modèles Meta de Team Colin.
#
# Sans cette ligne, la v7 partirait en défaut de flotte : sur `oropra` (le
# numéro de démonstration) et `test-demo`, le front réclamerait un motif, en
# afficherait l'aperçu, et l'ancienne fonction à trois paramètres le jetterait
# sans rien dire. Le vendeur relirait dans son fil un texte que le client
# n'aurait jamais reçu. À retirer quand les autres locataires auront reçu
# `wa-send-text` v24 et les modèles à quatre paramètres.
whatsapp      = teamcolin

# Module interne OROPRA : jamais de défaut de flotte.
onboarding   = oropra
