# ============================================================================
#  One Data — cibles de publication par module
#
#  Un module listé ici est en DÉPLOIEMENT CIBLÉ : publish.sh ne le promeut
#  jamais en version par défaut de la flotte, et l'épingle automatiquement
#  sur le ou les tenants indiqués.
#
#  Format :  <module> = <slug tenant>[,<slug tenant>…]
#  Un module absent de ce fichier garde le comportement historique
#  (promotion en défaut de flotte).
#
#  Pour sortir un module du mode ciblé : retirer sa ligne, ou publier une
#  fois avec --force-default.
# ============================================================================

# Modules refondus pour Team Colin : ils appellent des fonctions SQL
# (dashboard_tc_*, perf_equipe_tc, …) qui n'existent que dans ce tenant.
# Les promouvoir en défaut casserait les autres clients.
dashboard     = teamcolin
performances  = teamcolin
site-bus      = teamcolin
topnav        = teamcolin
phone3cx      = teamcolin
# Objectifs : la version du dépôt est celle de Team Colin (v8, KPI du
# reporting maison). Le reste de la flotte est en v3. Ajouté le 04/10/2026 :
# sans cette ligne, publier objectifs remplaçait la v3 de tous les clients.
objectifs     = teamcolin

# Notifications refondues (dette client) : elles appellent notif_lire,
# notif_feu, notif_dettes, notif_reporter… qui n'existent que chez Team Colin.
# Sans cette ligne, publish.sh les promouvrait en defaut de flotte et la page
# Notifications des autres clients tomberait en erreur.
notifications = teamcolin
notif-badge   = teamcolin

# Module interne OROPRA : jamais de défaut de flotte.
onboarding   = oropra
